# %% [cell 11] -- Ablation studies (ablation.py)
def run_ablations(epochs=20):
    scenarios = {
        "full":           dict(),
        "classical_only": dict(no_quantum=True),     # ablation 1
        "no_balancing":   dict(no_balance=True),     # ablation 2
        "deep_L3":        dict(depth=3),             # ablation 3 (barren plateau)
        "no_attention":   dict(no_fusion=True),      # ablation 4
    }
    results = {}
    for name, ov in scenarios.items():
        print(f"\n===== Ablation: {name} =====")
        m = train_model(epochs=epochs, out_name=f"abl_{name}.pt", resume=False, **ov)
        ds = MRNetDataset(ROOT, "valid", TASK, augment=False)
        loader = DataLoader(ds, 4, shuffle=False, collate_fn=mrnet_collate)
        p, y = collect_predictions(m, loader, DEVICE)
        r = full_report(p, y)
        results[name] = {k: r[k] for k in ["Accuracy","AUC-ROC","F1-Score","MCC"]}
    print(f"\n{'Scenario':16s}{'Acc':>8s}{'AUC':>8s}{'F1':>8s}{'MCC':>8s}")
    for n, r in results.items():
        print(f"{n:16s}{r['Accuracy']:8.3f}{r['AUC-ROC']:8.3f}{r['F1-Score']:8.3f}{r['MCC']:8.3f}")
    return results

