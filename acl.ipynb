@torch.no_grad()
def extract_fused_features(model, loader, device, max_batches=None):
    model.eval(); feats = []
    for b,(planes,_,_) in enumerate(loader):
        pf = torch.stack([model.encoder(planes.to(device)[:,p]) for p in range(3)], 1)
        feats.append((model.fusion(pf)[0] if model.use_fusion else pf.mean(1)).cpu())
        if max_batches and b+1 >= max_batches: break
    return torch.cat(feats, 0)

def shap_quantum(model, loader, device):
    import shap
    feats = extract_fused_features(model, loader, device, max_batches=8)
    bg, test = feats[:16], feats[16:24]
    class QHead(nn.Module):
        def __init__(s, m): super().__init__(); s.quantum=m.quantum; s.cls=m.classifier; s.uq=m.use_quantum
        def forward(s, x): return s.cls(s.quantum(x) if s.uq else x)
    head = QHead(model).to(device)
    sv = shap.DeepExplainer(head, bg.to(device)).shap_values(test.to(device), check_additivity=False)
    shap.summary_plot(sv, test.numpy(), feature_names=[f"q{i}" for i in range(test.shape[1])], show=True)
    return sv

