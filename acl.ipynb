import torch
DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")
print("Device:", DEVICE)

TASK = "acl"          # "acl" | "meniscus" | "abnormal"
ARCH = "resnet18"     # "resnet18" | "vgg16"
N_QUBITS = 10
VQC_DEPTH = 1         # shallow L=1 to avoid barren plateaus
QUANTUM_NOISE_SIGMA = 0.004
FIXED_SLICES = 17
IMG_SIZE = 256

# %% [cell 5] -- Dataset (dataset.py)
import numpy as np, pandas as pd
from torch.utils.data import Dataset, WeightedRandomSampler

PLANES = ("sagittal", "coronal", "axial")
IMAGENET_MEAN = np.array([0.485, 0.456, 0.406], dtype=np.float32)
IMAGENET_STD  = np.array([0.229, 0.224, 0.225], dtype=np.float32)

def uniform_sample_slices(volume, n=FIXED_SLICES):
    s = volume.shape[0]
    if s == n:
        return volume
    idx = np.round(np.linspace(0, s - 1, num=n)).astype(np.int64)
    idx = np.clip(idx, 0, s - 1)
    return volume[idx]

def normalize_volume(volume):
    vol = volume.astype(np.float32)
    vmin, vmax = vol.min(), vol.max()
    vol = (vol - vmin) / (vmax - vmin) if vmax > vmin else np.zeros_like(vol)
    vol = np.repeat(vol[:, None, :, :], 3, axis=1)          # (n,3,H,W)
    vol = (vol - IMAGENET_MEAN[None,:,None,None]) / IMAGENET_STD[None,:,None,None]
    return vol

class MRNetDataset(Dataset):
    def __init__(self, root, split="train", task="acl",
                 n_slices=FIXED_SLICES, augment=False):
        self.root, self.split, self.task = root, split, task
        self.n_slices = n_slices
        self.augment = augment and split == "train"
        df = pd.read_csv(os.path.join(root, f"{split}-{task}.csv"),
                         header=None, names=["case", "label"])
        df["case"] = df["case"].apply(lambda x: f"{int(x):04d}")
        self.cases = df["case"].tolist()
        self.labels = df["label"].astype(np.float32).tolist()

    def __len__(self): return len(self.cases)

    def _load_plane(self, plane, case):
        vol = np.load(os.path.join(self.root, self.split, plane, f"{case}.npy"))
        vol = uniform_sample_slices(vol, self.n_slices)
        return normalize_volume(vol)

    def __getitem__(self, i):
        case, label = self.cases[i], self.labels[i]
        planes = []
        for p in PLANES:
            vol = self._load_plane(p, case)
            if self.augment and np.random.rand() < 0.5:
                vol = vol[..., ::-1].copy()
            planes.append(torch.from_numpy(vol).float())
        return torch.stack(planes, 0), torch.tensor(label), case

    def class_counts(self):
        a = np.array(self.labels); pos = int(a.sum()); return len(a)-pos, pos

    def inverse_freq_weights(self):
        n, p = self.class_counts(); t = n + p
        return torch.tensor([t/(2*max(n,1)), t/(2*max(p,1))], dtype=torch.float32)

    def make_weighted_sampler(self):
        labels = np.array(self.labels).astype(int)
        n, p = self.class_counts()
        w = np.array([1.0/max(n,1), 1.0/max(p,1)])[labels]
        return WeightedRandomSampler(torch.from_numpy(w).double(), len(w), True)

def mrnet_collate(batch):
    planes = torch.stack([b[0] for b in batch], 0)
    labels = torch.stack([b[1] for b in batch], 0)
    cases  = [b[2] for b in batch]
    return planes, labels, cases

# %% [cell 6] -- Model (model.py): backbone, fusion, VQC
import torch.nn as nn, torch.nn.functional as F
import torchvision.models as tvm
import pennylane as qml

class SliceBackbone(nn.Module):
    def __init__(self, arch="resnet18", pretrained=True):
        super().__init__()
        if arch == "resnet18":
            net = tvm.resnet18(weights=tvm.ResNet18_Weights.DEFAULT if pretrained else None)
            self.features = nn.Sequential(*list(net.children())[:-2])
        elif arch == "vgg16":
            net = tvm.vgg16(weights=tvm.VGG16_Weights.DEFAULT if pretrained else None)
            self.features = net.features
        self.feat_dim = 512
        self.gap = nn.AdaptiveAvgPool2d(1)
        self.last_conv_features = None

    def forward(self, x):
        fmap = self.features(x)
        self.last_conv_features = fmap
        return self.gap(fmap).flatten(1), fmap

class PlaneEncoder(nn.Module):
    def __init__(self, backbone, n_out=N_QUBITS):
        super().__init__()
        self.backbone = backbone
        self.bottleneck = nn.Sequential(
            nn.Linear(backbone.feat_dim, 64), nn.ReLU(True), nn.Dropout(0.3),
            nn.Linear(64, n_out), nn.Tanh())

    def forward(self, slices):
        B, S = slices.shape[0], slices.shape[1]
        flat = slices.reshape(B*S, *slices.shape[2:])
        pooled, _ = self.backbone(flat)
        pooled = pooled.reshape(B, S, -1).max(dim=1).values
        return self.bottleneck(pooled) * torch.pi

class PlaneAttentionFusion(nn.Module):
    def __init__(self, dim=N_QUBITS):
        super().__init__()
        self.score = nn.Sequential(nn.Linear(dim, dim), nn.Tanh(), nn.Linear(dim, 1))

    def forward(self, pf):                       # (B,3,dim)
        w = torch.softmax(self.score(pf), dim=1)
        return (w * pf).sum(1), w.squeeze(-1)

def build_qnode(n_qubits=N_QUBITS, depth=VQC_DEPTH, diff_method="parameter-shift"):
    dev = qml.device("default.qubit", wires=n_qubits)
    @qml.qnode(dev, interface="torch", diff_method=diff_method)
    def circuit(inputs, w_entangle, w_qaf):
        for i in range(n_qubits):                      # Angle encoding R_y
            qml.RY(inputs[..., i], wires=i)
        for l in range(depth):                         # entangling layers
            for i in range(n_qubits):
                qml.RY(w_entangle[l, i, 0], wires=i)
                qml.RZ(w_entangle[l, i, 1], wires=i)
            for i in range(n_qubits):                  # cyclic CNOT
                qml.CNOT(wires=[i, (i + 1) % n_qubits])
        for i in range(n_qubits):                      # QAF attention
            qml.RZ(w_qaf[i, 0], wires=i)
            qml.RY(w_qaf[i, 1] * inputs[..., i], wires=i)
        return [qml.expval(qml.PauliZ(i)) for i in range(n_qubits)]
    shapes = {"w_entangle": (depth, n_qubits, 2), "w_qaf": (n_qubits, 2)}
    return circuit, shapes

class QuantumLayer(nn.Module):
    def __init__(self, n_qubits=N_QUBITS, depth=VQC_DEPTH,
                 noise_sigma=QUANTUM_NOISE_SIGMA, diff_method="parameter-shift"):
        super().__init__()
        qnode, shapes = build_qnode(n_qubits, depth, diff_method)
        self.qlayer = qml.qnn.TorchLayer(qnode, shapes)
        self.noise_sigma = noise_sigma

    def forward(self, x):
        q = self.qlayer(x)
        if self.training and self.noise_sigma > 0:
            q = q + torch.randn_like(q) * self.noise_sigma
        return q

class ACLInsightQNet(nn.Module):
    def __init__(self, arch="resnet18", pretrained=True, use_quantum=True,
                 use_fusion=True, depth=VQC_DEPTH, noise_sigma=QUANTUM_NOISE_SIGMA,
                 diff_method="parameter-shift"):
        super().__init__()
        self.use_quantum, self.use_fusion = use_quantum, use_fusion
        bb = SliceBackbone(arch, pretrained)
        self.encoder = PlaneEncoder(bb, N_QUBITS)
        self.fusion = PlaneAttentionFusion(N_QUBITS) if use_fusion else None
        self.quantum = QuantumLayer(N_QUBITS, depth, noise_sigma, diff_method) if use_quantum else None
        self.classifier = nn.Sequential(
            nn.Linear(N_QUBITS, 32), nn.ReLU(True), nn.Dropout(0.3), nn.Linear(32, 1))
        self._last_plane_weights = None

    def backbone_ref(self): return self.encoder.backbone

    def forward(self, planes):
        pf = torch.stack([self.encoder(planes[:, p]) for p in range(3)], 1)
        if self.use_fusion:
            fused, w = self.fusion(pf); self._last_plane_weights = w.detach()
        else:
            fused = pf.mean(1)
        q = self.quantum(fused) if self.use_quantum else fused
        return self.classifier(q).squeeze(-1)

# %% [cell 7] -- Losses + feature-space SMOTE (train.py)
class BinaryFocalLoss(nn.Module):
    def __init__(self, gamma=2.0, alpha=0.75):
        super().__init__(); self.gamma, self.alpha = gamma, alpha
    def forward(self, logits, targets):
        p = torch.sigmoid(logits)
        ce = F.binary_cross_entropy_with_logits(logits, targets, reduction="none")
        p_t = p*targets + (1-p)*(1-targets)
        a_t = self.alpha*targets + (1-self.alpha)*(1-targets)
        return (a_t * (1-p_t)**self.gamma * ce).mean()

def weighted_bce(class_weights):
    wn, wp = class_weights
    return nn.BCEWithLogitsLoss(pos_weight=torch.tensor([wp/wn]))

# Feature-space SMOTE (valid alternative; pixel-space SMOTE on volumes is infeasible)
def feature_space_smote(model, loader, device):
    from imblearn.over_sampling import SMOTE
    model.eval(); feats, ys = [], []
    with torch.no_grad():
        for planes, labels, _ in loader:
            planes = planes.to(device)
            pf = torch.stack([model.encoder(planes[:, p]) for p in range(3)], 1)
            fused = model.fusion(pf)[0] if model.use_fusion else pf.mean(1)
            feats.append(fused.cpu().numpy()); ys.append(labels.numpy())
    X = np.concatenate(feats); y = np.concatenate(ys).astype(int)
    Xr, yr = SMOTE().fit_resample(X, y)
    return torch.tensor(Xr, dtype=torch.float32), torch.tensor(yr, dtype=torch.float32)

# %% [cell 8] -- Training loop with Drive checkpointing
from torch.utils.data import DataLoader
from sklearn.metrics import roc_auc_score, accuracy_score

@torch.no_grad()
def quick_eval(model, loader, device):
    model.eval(); probs, ys = [], []
    for planes, labels, _ in loader:
        p = torch.sigmoid(model(planes.to(device))).cpu().numpy()
        probs.append(p); ys.append(labels.numpy())
    probs, ys = np.concatenate(probs), np.concatenate(ys)
    try: auc = roc_auc_score(ys, probs)
    except ValueError: auc = 0.5
    return auc, accuracy_score(ys, (probs >= 0.5).astype(int))

def train_model(root=ROOT, task=TASK, arch=ARCH, epochs=35, batch_size=4, lr=1e-4,
                weight_decay=1e-4, loss_name="focal", scheduler_name="cosine",
                depth=VQC_DEPTH, use_sampler=True, no_quantum=False,
                no_fusion=False, no_noise=False, no_balance=False,
                out_name="acl_insight_qnet.pt", resume=True):
    device = DEVICE
    if no_balance:
        use_sampler = False; loss_name = "weighted_bce"

    train_ds = MRNetDataset(root, "train", task, augment=True)
    valid_ds = MRNetDataset(root, "valid", task, augment=False)
    sampler = train_ds.make_weighted_sampler() if use_sampler else None
    train_loader = DataLoader(train_ds, batch_size, sampler=sampler,
                              shuffle=(sampler is None), num_workers=2,
                              collate_fn=mrnet_collate)
    valid_loader = DataLoader(valid_ds, batch_size, shuffle=False,
                              num_workers=2, collate_fn=mrnet_collate)

    model = ACLInsightQNet(arch, True, not no_quantum, not no_fusion, depth,
                           0.0 if no_noise else QUANTUM_NOISE_SIGMA).to(device)

    criterion = (BinaryFocalLoss(2.0, 0.75) if loss_name == "focal"
                 else weighted_bce(train_ds.inverse_freq_weights()).to(device))
    optimizer = torch.optim.AdamW(model.parameters(), lr=lr, weight_decay=weight_decay)
    scheduler = (torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=epochs)
                 if scheduler_name == "cosine"
                 else torch.optim.lr_scheduler.ReduceLROnPlateau(optimizer, "max",
                                                                 factor=0.5, patience=3))

    ckpt_path = os.path.join(CKPT_DIR, out_name)
    start_epoch, best_auc = 0, 0.0
    if resume and os.path.exists(ckpt_path):       # resume from Drive
        ck = torch.load(ckpt_path, map_location=device)
        model.load_state_dict(ck["model"])
        optimizer.load_state_dict(ck["optim"])
        start_epoch = ck.get("epoch", 0); best_auc = ck.get("best_auc", 0.0)
        print(f"Resumed from {ckpt_path} @ epoch {start_epoch}, best AUC {best_auc:.4f}")

    for epoch in range(start_epoch, epochs):
        model.train(); running = 0.0
        for planes, labels, _ in train_loader:
            planes, labels = planes.to(device), labels.to(device)
            optimizer.zero_grad()
            loss = criterion(model(planes), labels)
            loss.backward()
            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)
            optimizer.step()
            running += loss.item() * planes.size(0)
        val_auc, val_acc = quick_eval(model, valid_loader, device)
        scheduler.step() if scheduler_name == "cosine" else scheduler.step(val_auc)
        print(f"[{epoch+1:03d}/{epochs}] loss={running/len(train_ds):.4f} "
              f"val_acc={val_acc:.4f} val_auc={val_auc:.4f}")

        # save latest + best to Drive
        torch.save({"model": model.state_dict(), "optim": optimizer.state_dict(),
                    "epoch": epoch+1, "best_auc": best_auc}, ckpt_path)
        if val_auc > best_auc:
            best_auc = val_auc
            torch.save({"model": model.state_dict(), "optim": optimizer.state_dict(),
                        "epoch": epoch+1, "best_auc": best_auc},
                       os.path.join(CKPT_DIR, "best_" + out_name))
            print(f"  -> new best AUC {best_auc:.4f} saved to Drive")
    print("Best val AUC:", best_auc)
    return model

# Run training (comment out if you only want evaluation/XAI):
model = train_model(epochs=35)

# %% [cell 9] -- Evaluation: 15+ metrics, ROC, reliability, ECE (evaluate.py)
import matplotlib.pyplot as plt
from sklearn.metrics import (precision_score, recall_score, f1_score, roc_curve,
                             log_loss, brier_score_loss, balanced_accuracy_score,
                             matthews_corrcoef, confusion_matrix)

@torch.no_grad()
def collect_predictions(model, loader, device):
    model.eval(); probs, ys = [], []
    for planes, labels, _ in loader:
        probs.append(torch.sigmoid(model(planes.to(device))).cpu().numpy())
        ys.append(labels.numpy())
    return np.concatenate(probs), np.concatenate(ys)

def expected_calibration_error(probs, ys, n_bins=10):
    bins = np.linspace(0, 1, n_bins+1); ece = 0.0
    for i in range(n_bins):
        m = (probs > bins[i]) & (probs <= bins[i+1])
        if m.sum() == 0: continue
        ece += m.mean() * abs(probs[m].mean() - (ys[m] == (probs[m] >= .5)).mean())
    return ece

def reliability_diagram(probs, ys, n_bins=10, path="reliability.png"):
    bins = np.linspace(0,1,n_bins+1); c, a = [], []
    for i in range(n_bins):
        m = (probs > bins[i]) & (probs <= bins[i+1])
        if m.sum() == 0: continue
        c.append((bins[i]+bins[i+1])/2); a.append((ys[m] == (probs[m] >= .5)).mean())
    plt.figure(figsize=(5,5)); plt.plot([0,1],[0,1],"--",color="gray")
    plt.plot(c,a,"o-"); plt.xlabel("Confidence"); plt.ylabel("Accuracy")
    plt.title("Reliability Diagram"); plt.savefig(path, dpi=150, bbox_inches="tight"); plt.show()

def plot_roc(probs, ys, path="roc.png"):
    fpr, tpr, _ = roc_curve(ys, probs); auc = roc_auc_score(ys, probs)
    plt.figure(figsize=(5,5)); plt.plot(fpr,tpr,label=f"AUC={auc:.3f}")
    plt.plot([0,1],[0,1],"--",color="gray"); plt.legend()
    plt.xlabel("FPR"); plt.ylabel("TPR"); plt.title("ROC Curve")
    plt.savefig(path, dpi=150, bbox_inches="tight"); plt.show()

def full_report(probs, ys, threshold=0.5):
    preds = (probs >= threshold).astype(int)
    tn, fp, fn, tp = confusion_matrix(ys, preds, labels=[0,1]).ravel()
    return {
        "Accuracy": accuracy_score(ys, preds),
        "Precision (PPV)": precision_score(ys, preds, zero_division=0),
        "Recall (Sensitivity)": recall_score(ys, preds, zero_division=0),
        "Specificity": tn/(tn+fp) if (tn+fp) else 0.0,
        "F1-Score": f1_score(ys, preds, zero_division=0),
        "AUC-ROC": roc_auc_score(ys, probs),
        "Log Loss (BCE)": log_loss(ys, probs, labels=[0,1]),
        "Brier Score": brier_score_loss(ys, probs),
        "ECE": expected_calibration_error(probs, ys),
        "Balanced Accuracy": balanced_accuracy_score(ys, preds),
        "MCC": matthews_corrcoef(ys, preds),
        "FPR": fp/(fp+tn) if (fp+tn) else 0.0,
        "FNR": fn/(fn+tp) if (fn+tp) else 0.0,
        "NPV": tn/(tn+fn) if (tn+fn) else 0.0,
    }

def evaluate(ckpt="best_acl_insight_qnet.pt"):
    ds = MRNetDataset(ROOT, "valid", TASK, augment=False)
    loader = DataLoader(ds, 4, shuffle=False, collate_fn=mrnet_collate)
    m = ACLInsightQNet(ARCH, False, True, True, VQC_DEPTH).to(DEVICE)
    m.load_state_dict(torch.load(os.path.join(CKPT_DIR, ckpt), map_location=DEVICE)["model"])
    probs, ys = collect_predictions(m, loader, DEVICE)
    metrics = full_report(probs, ys)
    print("\n==== ACL Insight-QNet Evaluation ====")
    for k, v in metrics.items(): print(f"{k:24s}: {v:.4f}")
    plot_roc(probs, ys); reliability_diagram(probs, ys)
    return m, probs, ys

eval_model, probs, ys = evaluate()

# %% [cell 10] -- XAI: QGrad-CAM + SHAP (xai.py)
class QGradCAM:
    def __init__(self, model, device):
        self.model = model.to(device).eval(); self.device = device
        self.acts = self.grads = None
        tl = model.backbone_ref().features[-1]
        tl.register_forward_hook(lambda m,i,o: setattr(self, "acts", o.detach()))
        tl.register_full_backward_hook(lambda m,gi,go: setattr(self, "grads", go[0].detach()))
    def __call__(self, planes, slice_idx=None):
        planes = planes.to(self.device); self.model.zero_grad()
        self.model(planes).backward()
        w = self.grads.mean(dim=(2,3), keepdim=True)
        cam = F.relu((w * self.acts).sum(1))
        si = cam.shape[0]//2 if slice_idx is None else slice_idx
        h = cam[si].cpu().numpy(); h = (h-h.min())/(h.max()-h.min()+1e-8)
        h = F.interpolate(torch.tensor(h)[None,None], (256,256),
                          mode="bilinear", align_corners=False)[0,0].numpy()
        return h
    @staticmethod
    def overlay(mri, heat, path="qgradcam.png"):
        plt.figure(figsize=(5,5)); plt.imshow(mri, cmap="gray")
        plt.imshow(heat, cmap="jet", alpha=0.4); plt.axis("off")
        plt.title("QGrad-CAM"); plt.savefig(path, dpi=150, bbox_inches="tight"); plt.show()

# Example QGrad-CAM on one validation exam (sagittal plane, middle slice)
